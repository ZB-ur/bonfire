{
  "name": "bilibili-danmaku-denoiser",
  "version": "0.0.1",
  "private": true,
  "description": "Local-only MV3 extension that denoises Bilibili live and replay danmaku.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --ext .ts,.cts,.mts,.tsx,.cjs,.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.18"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.25",
    "@types/chrome": "0.0.268",
    "@types/node": "20.12.7",
    "@typescript-eslint/eslint-plugin": "7.7.0",
    "@typescript-eslint/parser": "7.7.0",
    "eslint": "8.57.0",
    "typescript": "5.4.5",
    "vite": "5.2.10",
    "vitest": "1.5.0"
  }
}
